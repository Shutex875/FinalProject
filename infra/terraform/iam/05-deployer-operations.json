{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SsmDescribeManagedInstances",
      "Effect": "Allow",
      "Action": "ssm:DescribeInstanceInformation",
      "Resource": "*"
    },
    {
      "Sid": "SsmSendCommandToProjectInstances",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:eu-west-3:394567896469:instance/*",
      "Condition": { "StringEquals": { "ssm:resourceTag/Project": "deck-market" } }
    },
    {
      "Sid": "SsmRunShellScriptDocument",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ssm:eu-west-3::document/AWS-RunShellScript"
    },
    {
      "Sid": "SsmReadCommandResult",
      "Effect": "Allow",
      "Action": ["ssm:GetCommandInvocation", "ssm:ListCommandInvocations", "ssm:ListCommands"],
      "Resource": "*"
    },
    {
      "Sid": "StsCallerIdentity",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    }
  ]
}