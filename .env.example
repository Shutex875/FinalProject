# Copy this file to `.env` in the repo root (and/or `server/.env`).
# Never commit real values. Generate strong random secrets for JWT_* and ADMIN_PASSWORD.

# --- Runtime ---
NODE_ENV=production
PORT=5000
# Public origin of the frontend (CORS + cookies). Example: https://your-domain.com
CLIENT_URL=http://localhost:3000

# --- PostgreSQL (local Docker / RDS) ---
POSTGRES_DB=extreme_gear_shop
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me
# Prisma connection string. For AWS RDS use the RDS endpoint, SSL if required:
# postgresql://USER:PASSWORD@RDS_HOST:5432/DB_NAME?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# --- Auth ---
JWT_SECRET=change-me-access-token-secret
JWT_REFRESH_SECRET=change-me-refresh-token-secret
JWT_ISSUER=ExtremeGearShop
JWT_AUDIENCE=client
JWT_EXPIRES_IN=15m

# --- Seed (local/dev only; do not run prisma db seed in production) ---
ADMIN_PASSWORD=change-me-admin-password

# --- Client (baked in at `npm run build` time) ---
# Use `/api` when Express serves the compiled client from the same origin.
REACT_APP_API_URL=/api
